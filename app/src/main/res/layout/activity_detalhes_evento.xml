<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5FC">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:background="#6A4BBC">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CampusHub"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETALHES"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Conteúdo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtTituloEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título do evento"
                android:textColor="#5E35B1"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA"
                android:textColor="#777777"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDataEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20/10/2026"
                android:textColor="#222222"
                android:textSize="18sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORÁRIO"
                android:textColor="#777777"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHorarioEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="14:00"
                android:textColor="#222222"
                android:textSize="18sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCAL"
                android:textColor="#777777"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLocalEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auditório Principal"
                android:textColor="#222222"
                android:textSize="18sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCRIÇÃO"
                android:textColor="#777777"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescricaoEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descrição do evento"
                android:textColor="#333333"
                android:textSize="17sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="30dp" />

            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VOLTAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#6A4BBC" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>